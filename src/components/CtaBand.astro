---
import { site, telHref } from '../lib/site';
---

<section class="bg-tile text-white">
  <div class="wrap flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
    <h2 class="section-title max-w-xl">Roof trouble won't fix itself.</h2>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={telHref} class="btn bg-ink text-cream hover:bg-ink2">Call {site.phone}</a>
      <a href="/contact" class="btn btn-line">Request a quote</a>
    </div>
  </div>
</section>
