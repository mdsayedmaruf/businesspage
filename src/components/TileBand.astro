---
// A strip of barrel tiles: the template's recurring visual signature.
const id = `tiles-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="block h-9 w-full" aria-hidden="true">
  <defs>
    <pattern id={id} width="64" height="36" patternUnits="userSpaceOnUse">
      <path d="M0 36V16a16 16 0 0 1 32 0v20z" class="fill-tile" />
      <path d="M32 36V16a16 16 0 0 1 32 0v20z" class="fill-tile2" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
