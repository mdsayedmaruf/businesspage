---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import headingFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const hide = noindex || site.demo;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  name: site.name,
  url: site.url,
  telephone: site.phoneE164,
  email: site.email,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: 'US',
  },
  areaServed: site.cities.map((name) => ({ '@type': 'City', name })),
  openingHours: site.hours.map((h) => h.schema),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={site.theme.ink} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {hide && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="pb-16 lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-sun focus:p-3 focus:text-ink">Skip to content</a>
    {
      site.demo && (
        <p class="bg-sun px-4 py-1.5 text-center text-sm font-semibold text-ink">
          Demo website. {site.name} is a fictional company. Reviews and details are samples, and photos are licensed stock images.
        </p>
      )
    }
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
