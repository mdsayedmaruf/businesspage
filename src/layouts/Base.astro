---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { hideFromSearch, site } from '../lib/site';
import headingFont from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import bodyFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Page-specific schema.org nodes, added to the site-wide graph. */
  schema?: Record<string, unknown>[];
}

const { title, description, noindex = false, schema: pageSchema = [] } = Astro.props;
const fullTitle = `${title} | ${site.name}`;
// Cloudflare redirects /about to /about/, so the slash version is the real URL.
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), site.url).toString();
const robots = hideFromSearch ? 'noindex, nofollow' : noindex ? 'noindex, follow' : undefined;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*.{jpg,jpeg,png,webp,avif}');
const heroPhoto = await photos[`/src/assets/projects/${site.hero.image}`]();
const shareImage = await getImage({ src: heroPhoto.default, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 80 });
const shareImageUrl = new URL(shareImage.src, site.url).toString();
const businessId = new URL('/#business', site.url).toString();

const business = {
  '@type': 'RoofingContractor',
  '@id': businessId,
  name: site.name,
  url: new URL('/', site.url).toString(),
  image: shareImageUrl,
  telephone: site.phoneE164,
  email: site.email,
  foundingDate: String(site.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postal,
    addressCountry: 'US',
  },
  areaServed: site.cities.map((name) => ({ '@type': 'City', name })),
  openingHours: site.hours.map((h) => h.schema),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Roofing services',
    itemListElement: site.services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, url: new URL(`/services/${s.slug}/`, site.url).toString() },
    })),
  },
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    business,
    { '@type': 'WebSite', name: site.name, url: new URL('/', site.url).toString(), publisher: { '@id': businessId } },
    ...pageSchema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={site.theme.ink} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.hero.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {robots && <meta name="robots" content={robots} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="pb-16 lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-sun focus:p-3 focus:text-ink">Skip to content</a>
    {
      site.demo && (
        <p class="bg-sun px-4 py-1.5 text-center text-sm font-semibold text-ink">
          Demo website. {site.name} is a fictional company. Reviews and details are samples, and photos are licensed stock images.
        </p>
      )
    }
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
