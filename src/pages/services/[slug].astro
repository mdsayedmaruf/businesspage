---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site, type Service } from '../../lib/site';

export function getStaticPaths() {
  return site.services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const pageUrl = new URL(`/services/${service.slug}/`, site.url).toString();
const otherServices = site.services.filter((s) => s.slug !== service.slug);

const schema = [
  {
    '@type': 'Service',
    name: service.title,
    description: service.short,
    url: pageUrl,
    serviceType: service.title,
    provider: { '@id': new URL('/#business', site.url).toString() },
    areaServed: site.cities.map((name) => ({ '@type': 'City', name })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).toString() },
      { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', site.url).toString() },
      { '@type': 'ListItem', position: 3, name: service.title, item: pageUrl },
    ],
  },
];
---

<Base title={`${service.title} in ${site.address.city}, ${site.address.region}`} description={`${service.short} Serving ${site.address.city} and nearby cities.`} schema={schema}>
  <PageHead eyebrow="Services" title={`${service.title} in ${site.address.city}`} />
  <section class="py-14 lg:py-20">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <Photo file={service.image} alt={service.imageAlt} art={service.art} widths={[640, 1000]} sizes="(min-width: 1024px) 50vw, 100vw" eager class="aspect-[20/13] w-full object-cover" />
        <p class="mt-6 text-lg">{service.body}</p>
        <h2 class="mt-8 text-3xl">What's included</h2>
        <ul class="mt-3 space-y-2">
          {service.points.map((p) => <li class="border-l-4 border-tile pl-3">{p}</li>)}
        </ul>
        <h2 class="mt-8 text-3xl">Areas we serve</h2>
        <p class="mt-3">{service.title} across {site.cities.slice(0, -1).join(', ')} and {site.cities.at(-1)}.</p>
        <h2 class="mt-8 text-3xl">Other roofing services</h2>
        <ul class="mt-3 space-y-2">
          {otherServices.map((s) => <li><a href={`/services/${s.slug}/`} class="font-semibold underline hover:text-tile">{s.title} in {site.address.city}</a></li>)}
        </ul>
      </div>
      <div class="lg:col-span-6"><QuoteForm title={`Ask about ${service.title.toLowerCase()}`} /></div>
    </div>
  </section>
  <CtaBand />
</Base>
